{
  "name": "pak-geodata",
  "version": "0.1.0",
  "description": "Comprehensive, typed, offline geographic data for all areas and cities in Pakistan",
  "author": "The Mohsin Project",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./areas/*": {
      "types": "./dist/areas/*.d.ts",
      "import": "./dist/areas/*.js",
      "require": "./dist/areas/*.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sohaibbinmohsin/pakistan-geodata.git",
    "directory": "packages/npm"
  },
  "homepage": "https://github.com/sohaibbinmohsin/pakistan-geodata#readme",
  "bugs": {
    "url": "https://github.com/sohaibbinmohsin/pakistan-geodata/issues"
  },
  "keywords": [
    "pakistan",
    "geodata",
    "gis",
    "coordinates",
    "provinces",
    "cities",
    "areas",
    "sectors",
    "postal-codes",
    "lahore",
    "karachi",
    "islamabad",
    "rawalpindi",
    "faisalabad",
    "geocoding",
    "reverse-geocoding",
    "haversine"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "tsx --test tests/**/*.test.ts"
  }
}
